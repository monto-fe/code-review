# ===========================================
# 1. 公共变量 (所有服务共用)
# ===========================================
# 部署机器IP
IP=localhost

# ===========================================
# 2. 数据库变量 (Backend 和 RAG Service 共用)
# ===========================================
# 数据库连接配置
DATABASE_HOST=165.154.112.72
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=mysql123456
DATABASE_NAME=ucode_review
DATABASE_CHARSET=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# 数据库类型支持
DB_TYPE=mysql

# ===========================================
# 3. Frontend 变量
# ===========================================
# 前端环境设置
NODE_ENV=production

# 前端服务配置
VITE_APP_APIHOST=http://localhost:9000
VITE_APP_DOMAIN=http://localhost
VITE_APP_PORT=3000

# ===========================================
# 4. Backend 变量
# ===========================================
# Backend API 服务配置
API_PORT=9000
CONSOLE_PORT=9003

# Backend 环境设置
BACKEND_ENV=production

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_HOURS=24

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,txt,md

# ===========================================
# 5. RAG Service 变量
# ===========================================
# RAG 服务基础配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=50051
SERVICE_MAX_WORKERS=10
SERVICE_MAX_MESSAGE_LENGTH=4194304
SERVICE_ENABLE_REFLECTION=true

# AI 模型配置
AI_PROVIDER=dashscope
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_MODEL=qwen-turbo
LOCAL_MODEL_PATH=./data/models
LOCAL_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# 向量存储配置
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AI 参数配置
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TOP_P=0.9

# RAG 功能配置
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=4000
RAG_ENABLE_RERANK=true

# Git 配置
GITLAB_TOKEN=
GIT_TEMP_DIR=/tmp/git_repos

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=ai_service.log

# ===========================================
# 6. 其他配置
# ===========================================
# 服务间通信配置
RAG_SERVICE_URL=http://localhost:50051

# Redis 配置 (可选)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# 安全配置
CORS_ORIGINS=http://localhost:3000,http://localhost:9000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
