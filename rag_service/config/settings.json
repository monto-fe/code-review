{
  "testing": {
    "service": {
      "host": "0.0.0.0",
      "port": 50051,
      "max_workers": 10,
      "max_message_length": 4194304,
      "enable_reflection": true
    },
    "database": {
      "host": "127.0.0.1",
      "port": 3306,
      "username": "root",
      "password": "123456",
      "database": "xxx_review",
      "charset": "utf8mb4",
      "pool_size": 10,
      "max_overflow": 20
    },
    "ai": {
      "provider": "dashscope",
      "openai": {
        "api_key": "",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-3.5-turbo"
      },
      "dashscope": {
        "api_key": "sk-xxxx",
        "model": "qwen-turbo"
      },
      "local": {
        "model_path": "./data/models",
        "model_name": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "vector_store": {
        "type": "faiss",
        "path": "./data/vector_store",
        "embedding_model": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "parameters": {
        "max_tokens": 2048,
        "temperature": 0.7,
        "top_p": 0.9
      }
    },
    "rag": {
      "chunk_size": 1000,
      "chunk_overlap": 200,
      "similarity_threshold": 0.7,
      "max_context_length": 4000,
      "enable_rerank": true
    },
    "git": {
      "token": "",
      "temp_dir": "/tmp/git_repos"
    },
    "logging": {
      "level": "INFO",
      "file": "ai_service.log"
    }
  },
  "production": {
    "service": {
      "host": "0.0.0.0",
      "port": 50051
    },
    "database": {
      "host": "mysql.production.com",
      "port": 3306,
      "username": "ai_service_user",
      "password": "production_password",
      "database": "ai_service_prod"
    },
    "ai": {
      "provider": "dashscope",
      "openai": {
        "api_key": "prod_openai_key",
        "model": "gpt-4"
      },
      "dashscope": {
        "api_key": "prod_dashscope_key",
        "model": "qwen-plus"
      }
    },
    "git": {
      "token": "prod_gitlab_token"
    },
    "logging": {
      "level": "WARNING"
    }
  }
}